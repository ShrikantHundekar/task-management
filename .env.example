# CodeFlow AI Environment Configuration

# Database (SQLite default for zero-friction local run; use postgresql://user:pass@host:5432/codeflow in production)
DATABASE_URL=sqlite:///./codeflow.db

# JWT Authentication
JWT_SECRET=super-secret-codeflow-jwt-token-minimum-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq Cloud AI Engine
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS & Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
